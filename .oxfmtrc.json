{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "bun.lock",
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts",
    "migrations/**",
    ".deploy/**",
    ".agents/**",
    ".codex/**"
  ]
}
