{
  "name": "fun-quiz",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "bun run generate-routes && tsc --noEmit",
    "test": "bun test src/lib",
    "test:e2e": "playwright test",
    "setup:local": "bun scripts/setup-local.ts",
    "setup:code": "bun scripts/show-setup-code.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:e2e": "wrangler d1 migrations apply DB --local --config e2e/worker/wrangler.jsonc --persist-to .wrangler/e2e-state",
    "db:migrate:e2e-google": "wrangler d1 migrations apply DB --local --config e2e/worker/google.jsonc --persist-to .wrangler/e2e-google-state",
    "check:client-secrets": "bun scripts/check-client-secrets.ts",
    "test:workers": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "nodemailer": "^10.3.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@playwright/test": "^1.64.1",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "jsqr": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0",
    "ws": "^8.22.1"
  },
  "packageManager": "bun@1.3.14"
}
