{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "funkwiz-e2e-school",
  "main": "../../src/server.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FUNKWIZ_MODE": "school",
    "BETTER_AUTH_URL": "http://127.0.0.1:3102",
    "BETTER_AUTH_SECRET": "e2e-only-fake-secret-never-use-in-production-2026",
    "TEACHER_EMAIL": "teacher@example.test",
    "TEACHER_SETUP_TOKEN": "e2e-only-fake-setup-code-never-use-in-production",
    "GOOGLE_CLIENT_ID": "e2e-partial-client-id",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "funkwiz-e2e-school",
      "database_id": "00000000-0000-0000-0000-000000000004",
      "migrations_dir": "../../migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_ROOMS",
        "class_name": "GameRoom",
      },
      {
        "name": "LIVE_JOIN_LIMITER",
        "class_name": "JoinLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-live-rooms",
      "new_sqlite_classes": ["GameRoom", "JoinLimiter"],
    },
  ],
}
