{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fun-quiz-e2e",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "http://127.0.0.1:3100",
    "BETTER_AUTH_SECRET": "e2e-only-fake-secret-never-use-in-production-2026",
    "TEACHER_EMAIL": "teacher@example.test",
    "TEACHER_SETUP_TOKEN": "e2e-only-fake-setup-code-never-use-in-production",
    "GOOGLE_CLIENT_ID": "e2e-partial-client-id",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fun-quiz-e2e",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../migrations",
    },
  ],
}
