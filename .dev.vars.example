# Required by Deploy to Cloudflare. Supply your own values in its setup form.
# For local development, bun run setup:local you@example.com generates this file.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
TEACHER_EMAIL=
TEACHER_SETUP_TOKEN=
# Optional: set school to enable invite-only multi-teacher workspaces.
# FUNKWIZ_MODE=personal

# Optional integrations: uncomment only the settings you need after first deploy.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Password reset email: saved teacher selection overrides this deployment default.
# AUTH_EMAIL_PROVIDER=resend
# AUTH_EMAIL_FROM=
# Resend
# RESEND_API_KEY=
# Cloudflare uses the EMAIL binding. For real local delivery, also configure
# remote: true on that binding before setting this flag.
# CLOUDFLARE_EMAIL_REMOTE=false
# Other SMTP services (implicit TLS on 465; required STARTTLS otherwise).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
